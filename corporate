    </div>
  </section>

  <section class="py-16 max-w-5xl mx-auto px-5">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      
      <!-- Serviço 1: Salão -->
      <div class="bg-[#121216] border border-zinc-800 rounded-3xl p-8 sm:p-10 hover:border-amber-500/40 transition flex flex-col justify-between shadow-xl">
