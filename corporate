    </div>
  </header>

  <section class="pt-40 pb-20 px-5 text-center relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-amber-900/20 via-[#08080A] to-[#08080A] -z-10"></div>
